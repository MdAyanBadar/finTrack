generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String                 @id @default(uuid())
  name            String
  email           String                 @unique
  password        String
  // SHA-256 of the personal key used by email/SMS auto-import; never stored in plain text
  ingestKeyHash   String?                @unique
  createdAt       DateTime               @default(now())
  transactions    Transaction[]
  budget          Budget?
  categoryBudgets CategoryBudget[]
  recurring       RecurringTransaction[]
  payeeRules      PayeeRule[]
  pots            SavingsPot[]
  splitGroups     SplitGroup[]
  pushSubs        PushSubscription[]
  notifications   NotificationLog[]
}

model Transaction {
  id           String    @id @default(uuid())
  userId       String
  title        String
  amount       Float
  type         String
  category     String
  date         DateTime
  createdAt    DateTime  @default(now())
  recurringId  String?
  source       String? // "email" | "sms" when auto-imported
  // Money you expect back (work expense, lent to a friend)
  owedBy       String? // who owes you: "Acme", "Rahul"
  settledAt    DateTime? // when they paid you back
  repaymentFor String? // set on the income entry that repays another transaction
  externalRef  String? // bank reference (RRN/UPI ref) or text hash, for de-duplication
  potId        String? // paid into a savings pot (BC/chit), or the payout from one
  splitId      String? // legacy: older splits made sibling rows

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurring RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  pot       SavingsPot?           @relation(fields: [potId], references: [id], onDelete: SetNull)
  shares    TransactionShare[]

  @@unique([recurringId, date])
  @@unique([userId, externalRef])
  @@index([userId, date])
}

model Budget {
  id            String   @id @default(uuid())
  userId        String   @unique
  monthlyBudget Float
  savingsGoal   Float
  salaryDay     Int      @default(1)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Spending limit for one category, per pay cycle
model CategoryBudget {
  id       String @id @default(uuid())
  userId   String
  category String
  limit    Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

// Rent, EMIs, subscriptions, salary... posted automatically each month
model RecurringTransaction {
  id         String    @id @default(uuid())
  userId     String
  title      String
  amount     Float // signed like Transaction: negative = expense
  type       String
  category   String
  dayOfMonth Int
  startDate  DateTime
  endMonth   String? // "YYYY-MM" last month it runs; null = always
  lastPosted DateTime?
  createdAt  DateTime  @default(now())

  potId String? // a monthly BC/chit payment feeds this pot

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pot          SavingsPot?   @relation(fields: [potId], references: [id], onDelete: SetNull)
  transactions Transaction[]
}

// "Always put this payee in this category" - applied to auto-imported transactions
model PayeeRule {
  id       String @id @default(uuid())
  userId   String
  payee    String // normalised (lowercase, single spaces)
  category String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, payee])
}

// A browser / home-screen app that can receive push notifications
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  timeZone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Notifications already sent, so each alert goes out once (key e.g. "over:2026-09-22")
model NotificationLog {
  id        String   @id @default(uuid())
  userId    String
  key       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// A savings pot: a BC/chit group, or any "put money aside" pot.
// Payments into it still count as money leaving your account; the pot shows
// how much of your spending was actually saved.
model SavingsPot {
  id            String    @id @default(uuid())
  userId        String
  name          String
  monthlyAmount Float? // what you pay in each month, if fixed
  months        Int? // how many months it runs (a 12-month BC, say)
  closedAt      DateTime? // when you received the pot
  createdAt     DateTime  @default(now())

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurring    RecurringTransaction[]
}

// A group of people you split bills with ("Goa trip", "Flatmates")
model SplitGroup {
  id        String   @id @default(uuid())
  userId    String
  name      String
  members   String[] // just names; they don't need accounts
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One person's share of a split bill. The bill stays a single transaction
// holding your own share; everyone else's share lives here until they pay you.
model TransactionShare {
  id            String    @id @default(uuid())
  transactionId String
  person        String
  amount        Float // what they owe you
  settledAt     DateTime?
  repaymentId   String? // the income entry created when they paid
  createdAt     DateTime  @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}
